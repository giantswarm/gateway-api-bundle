{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "install": {
            "description": "Merged into spec.install.remediation of the HelmRelease.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "retries": {
                    "description": "Number of retries before the install is given up. A negative number retries forever.",
                    "type": "integer"
                },
                "remediateLastFailure": {
                    "type": "boolean"
                },
                "ignoreTestFailures": {
                    "type": "boolean"
                }
            }
        },
        "upgrade": {
            "description": "Merged into spec.upgrade.remediation of the HelmRelease.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "retries": {
                    "description": "Number of retries before the upgrade is given up. A negative number retries forever.",
                    "type": "integer"
                },
                "remediateLastFailure": {
                    "type": "boolean"
                },
                "ignoreTestFailures": {
                    "type": "boolean"
                },
                "strategy": {
                    "type": "string",
                    "enum": [
                        "rollback",
                        "uninstall"
                    ]
                }
            }
        }
    }
}
